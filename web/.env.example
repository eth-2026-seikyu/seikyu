# Public (safe to expose to the browser — inlined at build time)
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your-api-key
NEXT_PUBLIC_WC_PROJECT_ID=your-walletconnect-cloud-project-id
NEXT_PUBLIC_WORLD_APP_ID=app_your_world_id_app_id
NEXT_PUBLIC_WORLD_ACTION=buy-receivable
NEXT_PUBLIC_WORLD_PRESET=passport
# Local/dev-only overrides for the app-owned contract addresses (see
# `@/lib/addresses`) — only used when `web/lib/deployments.sepolia.json`
# doesn't have a real deployment synced in yet, e.g. testing against your
# own anvil Sepolia fork. Ignored (and safe to leave set) once that file's
# addresses are non-zero.
NEXT_PUBLIC_INVOICE_MARKET=0xyour-local-invoice-market-address
NEXT_PUBLIC_INVOICE_REGISTRAR=0xyour-local-invoice-registrar-address
NEXT_PUBLIC_MOCK_USDC=0xyour-local-mock-usdc-address
NEXT_PUBLIC_USER_REGISTRY=0xyour-local-user-registry-address
NEXT_PUBLIC_PARENT_NAME=seikyu.eth

# Server-only (never exposed to the browser)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your-api-key
WORLD_RP_ID=your-world-id-relying-party-id
WORLD_RP_SIGNING_KEY=your-world-id-relying-party-signing-key
WORLD_ENV=staging
OPERATOR_PRIVATE_KEY=0xyour-operator-private-key
# Local/dev-only override for the market contract address. Must NOT be set in production.
LOCAL_MARKET_ADDRESS=0x0000000000000000000000000000000000000000
